---
export interface Props {
  currentSearch?: string;
  autofocus?: boolean;
}
const { currentSearch = "" } = Astro.props;
---

<color-mode palette="blue" class="d-block px-m-l py-m my-xl br-l surface-dyed">
  <form method="get" action="/soek">
    <label for="search" class="mb-xs v-form-label">Hva leter du etter?</label>
    <div class="stack-h gap-s">
      <input
        id="search"
        type="text"
        class="v-input flex-1"
        name="q"
        value={currentSearch}
      >
      <button class="v-button" type="submit">Søk</button>
    </div>
  </form>
</color-mode>
