---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
---

<ContentPageLayout frontmatter={{ title: 'Åh nei, vi fant ikke siden' }}>
  <div>
    <h1 class="fs-s mb-xs">Hei du!</h1>
    <div class="fs-xl stack t-medium">
      <p>
        Vi er åpne om alt.
      </p>
      <p>
        Også om det vi ikke har.
      </p>
      <p class="mt-xs">Og denne siden — den har vi ikke.</p>
    </div>

    <div class="my-l">
      Vennligst <a href="/">gå til forsiden</a> eller prøv søkefunksjonen
    </div>
  </div>

</ContentPageLayout>
