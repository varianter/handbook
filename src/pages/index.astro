---
import { getCollection, type CollectionEntry } from 'astro:content';
import SearchBox from 'src/components/search-form/SearchBox.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';

const allEntries: CollectionEntry<'handbook'>[] = await getCollection('handbook');
const fundamentEntries = allEntries
  .filter((e) => e.id.startsWith('fundamentet/'))
  .sort((a, b) => a.data.order - b.data.order);
---

<ContentPageLayout frontmatter={{ title: 'En variants håndbok' }}>
  <h1 class="fs-l">En variants håndbok</h1>

  <p>Her forsøker vi å beskrive hvordan ting gjøres i Variant, hva vi prøver å oppnå
  og hvorfor vi tenker som vi gjør. Denne er både for ansatte og folk som er
  nysgjerrige på hvordan det er å være en variant. Håndboka er et levende dokument
  som vi ønsker alle ansatte skal ha eierskap til. Vi oppfordrer alle til å endre
  eller legge til innhold i den. Håndboken
  <a href="https://github.com/varianter/handbook/">ligger åpent på GitHub</a> hvor
  <a href="https://help.github.com/articles/editing-files-in-your-repository/">alle kan sende inn endringer</a>
  eller <a href="https://github.com/varianter/handbook/issues">stille spørsmål</a>.</p>

  <p>Om du ikke er en variant men liker det du leser,
  <a href="https://www.variant.no/no/jobb">ta en titt på ledige stillinger hos oss</a>. Mer info
  om oss på <a href="https://www.variant.no">nettsiden vår</a>.</p>


    <SearchBox />


  <h4>Fundamentet</h4>

  <p>Her finner du alt om hvordan vi tenker og jobber i Variant – verdiene våre,
  hvordan vi balanserer jobb og liv, og hvordan vi kompenserer våre ansatte.</p>

  <ul>
    {fundamentEntries.map((entry) => (
      <li>
        <a href={`/${entry.id}`}>{entry.data.navTitle ?? entry.data.title}</a>
        {entry.data.description && ` – ${entry.data.description}`}
      </li>
    ))}
  </ul>
</ContentPageLayout>
