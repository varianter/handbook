---
// [...slug].astro — catch-all route for all content collection pages.
// Replaces per-page `layout:` frontmatter with centralized layout selection.
import { getCollection, render } from 'astro:content';
import GeneralLayout from '../layouts/GeneralLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('handbook');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

---

<GeneralLayout frontmatter={{ title: entry.data.title }} headings={headings} slug={entry.id}>
  <Content />
</GeneralLayout>
