---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title='Søk i håndboken'>
  <color-mode palette="blue" class="block pt-xl-2xl p-s-m bg-surface-sunken br-l">

    <form role="search" class="search-form stack">
      <label for="q" class="fs-l t-medium mb-xs">Søk i vår håndbok</label>
      <!-- <label for="q" class="form-label mb-3xs">Søk i vår håndbok</label> -->
      <input
        id="q"
        name="q"
        type="search"
        class="input"
        data-size="large"
        aria-label="Søk"
        autocomplete="off"
        enterkeyhint="search"
        autofocus
        autocomplete="off"
      />
    </form>

    <nav class="recent mt-m-l" aria-label="Andre har søkt etter" data-pagefind-ignore>
      <h3>Andre har søkt etter</h3>
      <div class="chips stack-horizontal gap-xs">
        <a class="link" data-size="small" href="?q=Lønn">Lønn</a>
        <a class="link" data-size="small" href="?q=Aksjer">Aksjer</a>
        <a class="link" data-size="small" href="?q=Fordeler">Fordeler</a>
        <a class="link" data-size="small" href="?q=Miljøfyrtårn">Miljøfyrtårn</a>
      </div>
    </nav>
  </color-mode>

  <div class="py-xl">
    <search-results aria-live="polite">
      <template data-template="result">
        <article class="typeset py-s">
          <h3><a data-slot="link"></a></h3>
          <div data-slot="excerpt"></div>
          <ul data-slot="subs" hidden></ul>
        </article>
      </template>
      <template data-template="empty">
        <p>🔎 Ingen direkte søkeresultater funnet.</p>
      </template>
      <template data-template="subresult">
        <li><a data-slot="link"></a><p data-slot="excerpt"></p></li>
      </template>
      <template data-template="loading">
        <p>Søker…</p>
      </template>
      <template data-template="unavailable">
        <p>Søk er ikke tilgjengelig akkurat nå.</p>
      </template>
      <div class="stack items-center" data-slot="output"></div>
    </search-results>
  </div>
</SiteLayout>

<script>
  import '../components/search-form/search-results';
  import { currentQuery, setQuery, onQueryChange } from '../components/search-form/query';
  import { find, debounce } from '../components/search-form/dom';

  const input = find(document, 'input[name="q"]', HTMLInputElement);
  input.value = currentQuery();

  // Keep the field in sync when the query changes from elsewhere (chip clicks,
  // deep links, browser back/forward).
  onQueryChange((q) => {
    if (input.value.trim() !== q) input.value = q;
  });

  // Live typing: keystrokes aren't navigations, so push them to the URL
  // ourselves. Only wired where the Navigation API can relay without a reload
  // — elsewhere, Enter → form submit → full reload is the fallback.
  if ('navigation' in window) {
    input.addEventListener('input', debounce(() => setQuery(input.value.trim()), 250));
  }
</script>
