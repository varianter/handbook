---
// PageToc.astro — "On this page" table of contents showing h2–h4 headings.
import type { TocItem } from './types';

interface Props {
  headings: TocItem[];
}
const { headings } = Astro.props;
console.log(headings);
---

{headings.length > 0 && (
  <nav class="page-toc" aria-label="På denne siden">
    <h2 class="fs-s">På denne siden</h2>
    <ul>
      {headings.map((h2) => (
        <li class="fs-m">
          <a href={`#${h2.slug}`}>{h2.value}</a>
          {h2.children.length > 0 && (
            <ul class="toc-sublist">
              {h2.children.map((h3) => (
                <li>
                  <a href={`#${h3.slug}`}>{h3.value}</a>
                  {h3.children.length > 0 && (
                    <ul class="toc-sublist">
                      {h3.children.map((h4) => (
                        <li>
                          <a href={`#${h4.slug}`}>{h4.value}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}

