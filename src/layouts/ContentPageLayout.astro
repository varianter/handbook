---
// ContentPageLayout.astro — layout for handbook content pages.
// Extends SiteLayout (chrome) with TOC, article wrapper, and edit-link footer.
import SiteLayout from './SiteLayout.astro';
import SidebarNav from './nav/SidebarNav.astro';
import type { CollectionEntry } from 'astro:content';
import type { Heading, TocItem } from './types';

export interface Props {
  frontmatter?: CollectionEntry<'handbook'>['data'];
  headings?: Heading[];
  /** Content collection slug — used to build the GitHub edit URL for .md pages */
  slug?: string;
}

const {
  frontmatter,
  headings = [],
  slug,
} = Astro.props;

const pageTitle = frontmatter?.title ?? 'Variant Håndbok';
const showToc = frontmatter?.toc ?? false;

// --- Build TOC tree from flat headings ---
function buildTocTree(headings: Heading[]): TocItem[] {
  const root: TocItem[] = [];
  const stack: TocItem[] = [];

  for (const h of headings) {
    const item: TocItem = {
      value: h.text,
      slug: h.slug,
      depth: h.depth,
      children: [],
    };

    while (stack.length > 0 && stack[stack.length - 1].depth >= h.depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      root.push(item);
    } else {
      stack[stack.length - 1].children.push(item);
    }
    stack.push(item);
  }
  return root;
}

const tocTree = buildTocTree(headings);
// If the first root item is an h1 (depth 1), use its children as the page-level TOC.
// Otherwise (e.g. no h1 in the markdown body), use root items directly.
const pageHeadings =
  tocTree[0]?.depth === 1 ? (tocTree[0]?.children ?? []) : tocTree;
// --- GitHub edit link ---
const editUrl = slug
  ? `https://github.com/varianter/handbook/tree/main/src/content/handbook/${slug}.md`
  : 'https://github.com/varianter/handbook/tree/main/src/pages/index.astro';

// --- Last-edited git metadata (resolved at build time by the loader) ---
const lastCommitSha = frontmatter?.lastCommitSha ?? null;
const lastCommitDate = frontmatter?.lastCommitDate ?? null;
const lastCommitUrl = frontmatter?.lastCommitUrl ?? null;
---

<SiteLayout title={pageTitle}>
  <div class="content-layout mt-l-xl">


  <div style="grid-area: sidebar">
    <SidebarNav
      headings={showToc ? pageHeadings : []}
      editUrl={editUrl}
      lastCommitSha={lastCommitSha}
      lastCommitDate={lastCommitDate}
      lastCommitUrl={lastCommitUrl}
    />
  </div>

  <article style="grid-area: content" stagger-reveal class="handbook typeset mx-auto " data-pagefind-body>
    <slot />
  </article>
  </div>
</SiteLayout>

<style>
.content-layout{
  display: grid;
  grid-template-columns: 1fr 240px;
  grid-template-areas: "content sidebar";
  gap: var(--spacing-l-xl);
}
</style>
