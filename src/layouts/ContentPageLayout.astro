---
// ContentPageLayout.astro — layout for handbook content pages.
// Extends SiteLayout (chrome) with TOC, article wrapper, and edit-link footer.

import type { CollectionEntry } from "astro:content";
import LastCommit from "../components/LastCommit.astro";
import SidebarNav from "./nav/SidebarNav.astro";
import SiteLayout from "./SiteLayout.astro";
import type { Heading, TocItem } from "./types";

export interface Props {
	frontmatter?: CollectionEntry<"handbook">["data"];
	headings?: Heading[];
	slug?: string;
}

const { frontmatter, headings = [] } = Astro.props;

const pageTitle = frontmatter?.title ?? "Variant Håndbok";
const pageDescription = frontmatter?.description;
const showToc = frontmatter?.toc ?? false;

function buildTocTree(headings: Heading[]): TocItem[] {
	const root: TocItem[] = [];
	const stack: TocItem[] = [];

	for (const h of headings) {
		const item: TocItem = {
			value: h.text,
			slug: h.slug,
			depth: h.depth,
			children: [],
		};

		while (stack.length > 0 && stack[stack.length - 1].depth >= h.depth) {
			stack.pop();
		}

		if (stack.length === 0) {
			root.push(item);
		} else {
			stack[stack.length - 1].children.push(item);
		}
		stack.push(item);
	}
	return root;
}

const tocTree = buildTocTree(headings);
// If the first root item is an h1 (depth 1), use its children as the page-level TOC.
// Otherwise (e.g. no h1 in the markdown body), use root items directly.
const pageHeadings =
	tocTree[0]?.depth === 1 ? (tocTree[0]?.children ?? []) : tocTree;

const lastCommit = frontmatter?.lastCommit ?? null;
---

<SiteLayout title={pageTitle}>
	<div class="content-layout pt-xl pb-m">
		<div
			class="mx-auto typeset w-full"
			style="grid-row: span 2;"
			stagger-reveal
		>
			<h1>{pageTitle}</h1>
			<p class="mt-0">{pageDescription}</p>
			<LastCommit lastCommit={lastCommit} />
		</div>
	</div>
	<div class="content-layout mt-l-xl stack-horizontal items-start">
		<article
			style="grid-area: content;"
			stagger-reveal
			class="handbook typeset mx-auto "
			data-pagefind-body
		>
			<slot />
		</article>
		{showToc &&
  <div style="grid-area: sidebar;">
    <SidebarNav
      headings={showToc ? pageHeadings : []}
    />
  </div>}
	</div>
</SiteLayout>

<style>
.content-layout {
	display: grid;
	grid-template-columns: 1fr 240px;
	grid-template-areas: "content sidebar";
	gap: var(--spacing-l-xl);

	@media (max-width: 800px) {
		grid-template-columns: 1fr;
		grid-template-areas:
			"sidebar"
			"content";
	}
}
</style>
