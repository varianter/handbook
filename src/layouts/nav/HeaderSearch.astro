---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<form
  class:list={['header-search', 'pile', className]}
  action="/soek"
  method="get"
  aria-label="Søk"
>
  <input
    name="q"
    type="search"
    class="v-input pl-l w-full"
    aria-label="Søk"
    autocomplete="off"
    enterkeyhint="search"
  >
  <div
    class="pl-xs pr-xs self-center justify-self-start d-inline-flex ink-default"
  >
    <svg
      viewBox="0 0 22 21"
      style="width: 1em;"
      class="aspect-square"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="presentation"
    >
      <circle
        cx="9.225"
        cy="9.225"
        r="8.225"
        stroke="currentColor"
        stroke-width="2"
      />
      <line
        x1="16.0821"
        y1="14.6679"
        x2="21.2071"
        y2="19.7929"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
  </div>
</form>
