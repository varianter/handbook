---
import type { NavItem } from "../../config/navigation";
import type { HandbookLink } from "../types";
import HeaderSearch from "./HeaderSearch.astro";

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
  subItems: Record<string, NavItem[]>;
}

const { handbooks, subItems } = Astro.props;

function getSubItems(path: string): NavItem[] {
  return subItems[path] ?? [];
}
---

<button
  type="button"
  class="mobile-nav__trigger v-button ml-auto px-m py-xs"
  data-variant="outlined"
  data-size="small"
  popovertarget="mobile-nav-popover"
  aria-haspopup="menu"
>
  <svg
    role="presentation"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-menu aspect-square"
    style="
        width: 1lh;
        height: 1lh;
        margin-top: -1px;
    "
  >
    <path d="M4 5h16" />
    <path d="M4 12h16" />
    <path d="M4 19h16" />
  </svg>
  Meny
</button>
<div
  id="mobile-nav-popover"
  popover="auto"
  data-type="drawer"
  data-position="top"
  data-backdrop
  class="mobile-nav__popover v-popover"
>
  <nav class="stack-v m-s surface-tinted br-m p-xs">
    <HeaderSearch class="mb-xs" />

    {handbooks.map((handbook) => {
      const items = getSubItems(handbook.path);

      return (
        <details class="b-b bc-subtle b-none:last-child" name="handbook-nav" >
          <summary class="stack-h justify-between fs-s px-2xs py-xs summary-fix">{handbook.title}</summary>
          <ul class="pb-2xs pt-3xs">
            {items.map((item) => (
              <li class="b-l pl-s bc-subtle pb-2xs">
                <a class="w-full d-block py-3xs" href={item.external ? item.path : `/${item.path}`}>
                  <h3 class="fs-s lh-snug">
                    {item.title}
                  </h3>
                  <p class="fs-s ink-subtle mt-4xs">
                    {item.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </nav>
</div>

<style>
/* Trigger hidden by default; only shown on mobile below. */
.mobile-nav__trigger {
  display: none;
}

@media (max-width: 800px) {
  .mobile-nav__trigger {
    display: inline-flex;
  }

  .mobile-nav__popover summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__popover summary::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--border-default);
    border-bottom: 2px solid var(--border-default);
    transform: rotate(45deg);
    transition: transform 0.15s;
  }

  .mobile-nav__popover details[open] > summary::after {
    transform: rotate(-135deg);
  }
}
</style>
