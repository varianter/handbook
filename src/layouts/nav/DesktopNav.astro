---
import type { NavItem } from "../../config/navigation";
import type { HandbookLink } from "../types";
import HeaderSearch from "./HeaderSearch.astro";

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
  subItemsCache: Record<string, NavItem[]>;
}

const { handbooks, asPath, subItemsCache } = Astro.props;

function getSubItems(path: string): NavItem[] {
  return subItemsCache[path] ?? [];
}
---

<ul class="header__handbooks stack-h gap-3xs mx-auto">
  {handbooks.map((handbook) => {
    const isActive = `/${handbook.path}` === asPath ||
      (asPath === '/' && handbook.path === '') ||
      (handbook.path !== '' && asPath.startsWith(`/${handbook.path}`));

    const linkClass = isActive
      ? 'active'
      : '';

    const subItems = getSubItems(handbook.path);
    const popoverId = `header-popover-${handbook.path || 'fundamentet'}`;
    const buttonId = `header-btn-${handbook.path || 'fundamentet'}`;
    return (
      <li class={linkClass}>
            <button
              type="button"
              id={buttonId}
              class="v-button"
              data-variant="plain"
              data-size="small"
              popovertarget={popoverId}
              data-js-hover
            >
              {`${handbook.title}`}
            </button>
            <div id={popoverId} popover="auto" class="header-popover v-popover">
              <ul class="stack-v gap-2xs br-m shadow-mid surface-tinted p-3xs-2xs" stagger-items>
                {subItems.map((item) => (
                  <li class="">
                  <a class="stack-v gap-4xs fs-s px-3xs py-3xs bg-wash:hover br-m" href={item.external ? item.path : `/${item.path}`}>
                      <span class="fw-medium fs-s">{item.title}</span>
                      {item.description && <span class="fs-s ink-subtle lh-snug subnav-description">{item.description}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
      </li>
    );
  })}
</ul>

<!-- Hidden on mobile; the MobileNav popover has its own search field. -->
<div class="header-search--desktop">
  <HeaderSearch />
</div>

<style>
.header-popover {
  position: fixed;
  position-anchor: auto;
  top: anchor(bottom);
  left: anchor(left);

  margin: 0;
  margin-top: var(--spacing-m);
  border: none;
  max-width: 38ch;
  min-width: 15ch;
}

.subnav-description {
  text-wrap: balance;
}

@media (max-width: 800px) {
  .header__handbooks {
    display: none;
  }

  .header-search--desktop {
    display: none;
  }
}
</style>

<style is:global>
</style>
