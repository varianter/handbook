---
// Header.astro — site header composing desktop and mobile navigation.
import DesktopNav from './nav/DesktopNav.astro';
import MobileNav from './nav/MobileNav.astro';
import type { HandbookLink } from './types';
import type { NavItem } from '../config/navigation';

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
  subItemsCache: Record<string, NavItem[]>;
}

const { handbooks, asPath, subItemsCache } = Astro.props;
---

<header class="header pb-xl w-full" id="top-header">
  <DesktopNav handbooks={handbooks} asPath={asPath} subItemsCache={subItemsCache} />
  <MobileNav handbooks={handbooks} asPath={asPath} subItems={subItemsCache} />
</header>

<style>
  .header {
    margin-inline: auto;
    z-index: 1;

    @media (min-width: 800px) {
      position: sticky;
      top: var(--spacing-m);
    }
  }
</style>
