---
// SiteFooter.astro — global footer with site-wide navigation, social media links and CC license.
import type { HandbookLink } from './types';
import type { NavItem } from '../config/navigation';

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
  subItemsCache: Record<string, NavItem[]>;
}

const { handbooks, asPath, subItemsCache } = Astro.props;

function getSubItems(path: string): NavItem[] {
  return subItemsCache[path] ?? [];
}
---


<footer class="footer">
  <nav class="py-xl">
    <ul class="stack-horizontal items-start gap-xl">
      {
        handbooks.map((handbook) => {
          const _isActive = `/${handbook.path}` === asPath ||
            (asPath === '/' && handbook.path === '') ||
            (handbook.path !== '' && asPath.startsWith(`/${handbook.path}`));

          void _isActive; // used only during development for debugging active state

          const subItems = getSubItems(handbook.path);
          return (
            <li class="flex-1 px-s">
              <h6 class="t-bold fs-s mb-m stack">{handbook.title}</h6>
              <ul class="stack gap-xs">
                {subItems.map((item) => (
                  <li>
                    <a class="link" href={item.external ? item.path : `/${item.path}`}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </nav>


  <div class="py-xl" >
    <ul class="stack-horizontal justify-center gap-xs">
      <li>
        <a href="https://blog.variant.no" title="Variant Blogg" rel="external">
          <img src="/assets/logos/medium.svg" alt="Variant på Medium.com" />
        </a>
      </li>
      <li>
        <a href="https://github.com/varianter" title="Variant på Github" rel="external">
          <img src="/assets/logos/github.svg" alt="Variant på Github" />
        </a>
      </li>
      <li>
        <a href="https://instagram.com/variant_as" title="Variant på Instagram" rel="external">
          <img src="/assets/logos/instagram.svg" alt="Variant på Instagram" />
        </a>
      </li>
      <li>
        <a href="https://fb.me/varianter" title="Variant på Facebook" rel="external">
          <img src="/assets/logos/facebook.svg" alt="Variant på Facebook" />
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/company/variant-as/" title="Variant på LinkedIn" rel="external">
          <img src="/assets/logos/linkedin.svg" alt="Variant på LinkedIn" />
        </a>
      </li>
    </ul>
    <div class="stack items-center py-m">
      <a rel="license" href="http://creativecommons.org/licenses/by-sa/4.0/">
        <img
          alt="Creative Commons License"
          src="https://i.creativecommons.org/l/by-sa/4.0/80x15.png"
        />
      </a>
    </div>
  </div>
</footer>
