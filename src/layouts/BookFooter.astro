---
// BookFooter.astro — "edit this page" link shown below page content
interface Props {
  editUrl: string;
}

const { editUrl } = Astro.props;
---

<footer class="pt-l-xl my-l-xl">
  <color-mode palette="blue">
    <div class="bg-surface-sunken br-m p-m-l stack-horizontal gap-m">
      <div class="mw-6">
        <h6 class="fs-xs t-bold">Boop!</h6>
        <p>
          Noe som ikker stemmer eller som kunne vært bedre? Denne håndboken ligger åpen på GitHub.
        </p>
      </div>
      <a class="button ml-auto" data-variant="outlined" data-size="small" data-color="inherit" href={editUrl}>Foreslå endring</a>
    </div>
  </color-mode>
</footer>


