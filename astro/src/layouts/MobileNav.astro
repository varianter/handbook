---
// MobileNav.astro — always-visible mobile navigation using <details>/<summary> accordion.
// No JS required: the "name" attribute gives exclusive accordion behavior for free.
import type { NavItem } from '../config/navigation';

interface HandbookLink {
  path: string;
  title: string;
}

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
  subItems: Record<string, NavItem[]>;
}

const { handbooks, asPath, subItems } = Astro.props;

function getSubItems(path: string): NavItem[] {
  return subItems[path] ?? [];
}
---

<nav class="mobile-nav b-all b-faint bg-surface-raised br-m mt-s px-xs">
  {handbooks.map((handbook) => {
    const isActive = `/${handbook.path}` === asPath ||
      (handbook.path !== '' && asPath.startsWith(`/${handbook.path}`));

    const items = getSubItems(handbook.path);

    return (
      <details class="b-b b-faint b-last-none py-xs px-xs" name="handbook-nav" open={isActive}>
        <summary class="stack-horizontal justify-between fs-s">{handbook.title}</summary>
        <ul class="pb-s pl-m pt-m" stagger-reveal>
          {items.map((item) => (
            <li>
              <a class="w-full py-xs" href={item.external ? item.path : `/${item.path}`}>
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    );
  })}
</nav>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 800px) {
    .mobile-nav {
      display: block;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav summary::after {
      content: '';
      width: 0.5rem;
      height: 0.5rem;
      border-right: 2px solid var(--border-default);
      border-bottom: 2px solid var(--border-default);
      transform: rotate(45deg);
      transition: transform 0.15s;
    }

    .mobile-nav details[open] > summary::after {
      transform: rotate(-135deg);
    }
  }
</style>
