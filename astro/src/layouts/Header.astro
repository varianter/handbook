---
// Header.astro — top navigation bar with handbook links and popover sub-menus.
import magnifyingGlassSvg from './magnifyingGlass.svg';
import { getSectionPages } from '../config/navigation';
import type { NavItem } from '../config/navigation';

interface HandbookLink {
  path: string;
  title: string;
}

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
}

const { handbooks, asPath } = Astro.props;

// Pre-fetch all section sub-pages so the template can look them up synchronously
const subItemsCache: Record<string, NavItem[]> = {
  fundamentet: await getSectionPages('fundamentet'),
  information: await getSectionPages('information'),
  avdelinger: await getSectionPages('avdelinger'),
  prosesser: await getSectionPages('prosesser'),
};

function getSubItems(path: string): NavItem[] {
  return subItemsCache[path] ?? [];
}
---

<header class="header pt-3xl pb-xl" id="top-header">
  <nav class="stack-horizontal justify-center gap-xl">


  <a href="/"  aria-label="Variants handbook homepage"class="header-logo-link stack items-start">
    <img style="height: 12px;" src="/assets/logos/variant-logo.svg" alt="Variants logo" />
    <span class="fs-l ">Handbok</span>
  </a>

  <ul class="header__handbooks stack-horizontal gap-xl">
    {handbooks.map((handbook, index) => {
      const isActive = `/${handbook.path}` === asPath ||
        (asPath === '/' && handbook.path === '') ||
        (handbook.path !== '' && asPath.startsWith(`/${handbook.path}`));

      const linkClass = isActive
        ? 'active'
        : '';

      const subItems = getSubItems(handbook.path);
      const popoverId = `header-popover-${handbook.path || 'fundamentet'}`;
      return (
        <li class={linkClass}>
              <button
                class="fs-m t-bold"
                popovertarget={popoverId}
                data-js-hover
              >
                {`${handbook.title}`}
              </button>
              <div id={popoverId} popover="auto" class="header-popover" data-anchored>
                <ul stagger-reveal class="stack gap-s">
                  {subItems.map((item) => (
                    <li class="stack gap-xs">
                      <a class="subnav-link" href={item.external ? item.path : `/${item.path}`}>
                        <span class="t-bold">{item.title}</span>
                        {item.description && <span class="subnav-description">{item.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
        </li>
      );
    })}
  </ul>
      <button class="header-search-trigger fs-s stack-horizontal" aria-label="Åpne søk">
        <img
          src={magnifyingGlassSvg.src}
          alt="Forstørrelseglass"
          width="30"
          height="30"
        />
        <span>Søk</span>
      </button>
      <search-popover target=".header-search-trigger"></search-popover>
   </nav>
</header>

<style>
  .header-logo-link{
    text-decoration: none;
    color: var(--text-primary);

  }
  .header-popover {
    margin: 0;
    margin-top: var(--spacing-xs);
    margin-left: calc(var(--spacing-l) * -1);
    padding: var(--spacing-l) var(--spacing-l);
    border: none;
    background: var(--surface-violet-light);
    max-width: 20ch;
    color: var(--text-primary);
  }

  .subnav-link{
    text-decoration: none;
    display: inline-flex;
    flex-direction: column;
    color: currentColor;
    font-size: var(--font-size-xs);
  }

  .subnav-description {
    color: var(--text-secondary);
    text-wrap: pretty;
  }


</style>
