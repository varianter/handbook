---
// Header.astro — top navigation bar with handbook links and popover sub-menus.
import magnifyingGlassSvg from './magnifyingGlass.svg';
import { PROCESS_THEMES, LOCATIONS, FUNDAMENTET_SECTIONS, INFORMATION_SECTIONS } from '../config/navigation';

interface HandbookLink {
  path: string;
  title: string;
}

interface Props {
  handbooks: HandbookLink[];
  asPath: string;
}

const { handbooks, asPath } = Astro.props;

function getSubItems(path: string) {
  if (path === 'fundamentet') return FUNDAMENTET_SECTIONS;
  if (path === 'information') return INFORMATION_SECTIONS;
  if (path === 'prosesser') return PROCESS_THEMES;
  if (path === 'avdelinger') return LOCATIONS;
  return null;
}
---

<header class="header stack-horizontal justify-center gap-xl py-xl" id="top-header">
  <div class="stack items-start">
    <img style="height: 12px;" src="/assets/logos/variant-logo.svg" alt="Variants logo" />
    <span class="fs-l">Handbok</span>
  </div>

  <ul class="header__handbooks stack-horizontal gap-m">
    {handbooks.map((handbook, index) => {
      const isActive = `/${handbook.path}` === asPath ||
        (asPath === '/' && handbook.path === '') ||
        (handbook.path !== '' && asPath.startsWith(`/${handbook.path}`));

      const linkClass = isActive
        ? 'active'
        : '';

      const subItems = getSubItems(handbook.path);
      const popoverId = `header-popover-${handbook.path || 'fundamentet'}`;
      return (
        <li class={linkClass}>
          {subItems ? (
            <>
              <button
                class="fs-s"
                popovertarget={popoverId}
              >
                {`${index + 1}. ${handbook.title}`}
              </button>
              <div id={popoverId} popover="auto" class="header-popover" data-anchored>
                <ul stagger-reveal>
                  {subItems.map((item) => (
                    <li>
                      <a href={item.external ? item.path : `/${item.path}`}>
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </>
          ) : (
            <a href={`/${handbook.path}`} class="desktop-nav-link">
              {`${index + 1}. ${handbook.title}`}
            </a>
          )}
        </li>
      );
    })}

      <button class="header-search-trigger" aria-label="Åpne søk">
        <img
          src={magnifyingGlassSvg.src}
          alt="Forstørrelseglass"
          width="30"
          height="30"
        />
        <span>Søk</span>
      </button>
      <search-popover target=".header-search-trigger"></search-popover>

  </ul>
</header>

<style>
  .header-popover {
    margin: 0;
    padding: 0.75rem 1rem;
    border: none;
  }
</style>
