---
// MobileHamburger.astro — hamburger menu button for mobile sidebar toggle.
// Uses the Popover API (popovertarget) — no JS required for toggle/close/Escape/backdrop.
// Open-state animation driven by :has(:popover-open) CSS selectors below.

interface Props {
  isLandingpage: boolean;
}

const { isLandingpage } = Astro.props;
---

<div class="burgerButtonContainer">
  <span hidden id="menu-label">Hovedmeny</span>
  <button
    class={isLandingpage ? 'hamburger__dark' : 'hamburger'}
    type="button"
    popovertarget="sidebar-nav"
    aria-labelledby="menu-label"
    id="hamburger-btn"
  >
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </button>
</div>

<style>
  .burgerButtonContainer {
    position: fixed;
    cursor: pointer;
    top: 0.5rem;
    left: 1rem;
    z-index: 200;
    margin-top: 1rem;
  }

  .hamburger,
  .hamburger__dark {
    width: 3rem;
    height: 3rem;
    position: relative;
    margin: 2rem auto;
    transform: rotate(0deg);
    transition: 0.5s ease-in-out;
    cursor: pointer;
    background: transparent;
    border: 0;
  }

  .hamburger span,
  .hamburger__dark span {
    display: block;
    position: absolute;
    height: 4px;
    width: 100%;
    background: var(--color-secondary4__tint2);
    border-radius: 9px;
    opacity: 1;
    transform: rotate(0deg);
    transition: 0.25s ease-in-out;
    --spacings: 0.5rem;
  }

  .hamburger span {
    border: 2px solid var(--color-secondary1__shade2);
  }

  .hamburger__dark span {
    border: 2px solid var(--color-secondary4__tint2);
  }

  .hamburger span:nth-child(1),
  .hamburger__dark span:nth-child(1) {
    top: calc(var(--spacings) * 0);
  }

  .hamburger span:nth-child(2),
  .hamburger span:nth-child(3),
  .hamburger__dark span:nth-child(2),
  .hamburger__dark span:nth-child(3) {
    top: calc(var(--spacings) * 1);
  }

  .hamburger span:nth-child(4),
  .hamburger__dark span:nth-child(4) {
    top: calc(var(--spacings) * 2);
  }

  /* ---- Open state (bars → X) driven by popover, not a JS class ---- */

  body:has(#sidebar-nav:popover-open) .hamburger span,
  body:has(#sidebar-nav:popover-open) .hamburger__dark span {
    border: 2px solid var(--color-secondary4__tint2);
  }

  body:has(#sidebar-nav:popover-open) .hamburger span:nth-child(1),
  body:has(#sidebar-nav:popover-open) .hamburger__dark span:nth-child(1) {
    top: calc(var(--spacings) * 1);
    width: 0%;
    left: 50%;
  }

  body:has(#sidebar-nav:popover-open) .hamburger span:nth-child(2),
  body:has(#sidebar-nav:popover-open) .hamburger__dark span:nth-child(2) {
    transform: rotate(45deg);
  }

  body:has(#sidebar-nav:popover-open) .hamburger span:nth-child(3),
  body:has(#sidebar-nav:popover-open) .hamburger__dark span:nth-child(3) {
    transform: rotate(-45deg);
  }

  body:has(#sidebar-nav:popover-open) .hamburger span:nth-child(4),
  body:has(#sidebar-nav:popover-open) .hamburger__dark span:nth-child(4) {
    top: calc(var(--spacings) * 1);
    width: 0%;
    left: 50%;
  }

  @media (min-width: 1200px) {
    .hamburger {
      display: none;
    }
  }
</style>
