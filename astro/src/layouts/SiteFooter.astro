---
// SiteFooter.astro — global footer with social media links and CC license
---

<footer class="footer">
  <div class="footer__inner">
    <ul class="footer__social">
      <li>
        <a href="https://blog.variant.no" title="Variant Blogg" rel="external">
          <img src="/src/layouts/logos/medium.svg" alt="Variant på Medium.com" />
        </a>
      </li>
      <li>
        <a href="https://twitter.com/variant_as" title="Variant på Twitter" rel="external">
          <img src="/src/layouts/logos/twitter.svg" alt="Variant på Twitter" />
        </a>
      </li>
      <li>
        <a href="https://github.com/varianter" title="Variant på Github" rel="external">
          <img src="/src/layouts/logos/github.svg" alt="Variant på Github" />
        </a>
      </li>
      <li>
        <a href="https://instagram.com/variant_as" title="Variant på Instagram" rel="external">
          <img src="/src/layouts/logos/instagram.svg" alt="Variant på Instagram" />
        </a>
      </li>
      <li>
        <a href="https://fb.me/varianter" title="Variant på Facebook" rel="external">
          <img src="/src/layouts/logos/facebook.svg" alt="Variant på Facebook" />
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/company/variant-as/" title="Variant på LinkedIn" rel="external">
          <img src="/src/layouts/logos/linkedin.svg" alt="Variant på LinkedIn" />
        </a>
      </li>
    </ul>
    <div>
      <a rel="license" href="http://creativecommons.org/licenses/by-sa/4.0/">
        <img
          alt="Creative Commons License"
          src="https://i.creativecommons.org/l/by-sa/4.0/80x15.png"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: url('/src/layouts/footer.svg') no-repeat center top;
    margin-top: auto;
  }

  .footer__inner {
    position: relative;
    z-index: 2;
    max-width: 45rem;
    margin: 0 auto;
    min-height: 20rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer__social {
    list-style: none;
    display: flex;
    align-items: flex-start;
    margin: 0;
    padding: 0;
  }

  .footer__social li {
    margin: 0;
  }

  .footer__social a {
    margin: 0;
    display: block;
    padding: 1rem 0.3rem;
  }

  .footer__social img {
    display: block;
  }
</style>
