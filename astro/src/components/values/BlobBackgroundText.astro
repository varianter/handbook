---
export interface Props {
  headingText: string;
  text: string;
  blobNr: number;
}
const { headingText, text, blobNr } = Astro.props;
---
<div class="blobBackgroundText">
  <img
    src={`/assets/backgroundBlobs/blob${blobNr}.svg`}
    role="none"
    alt=""
    class="blobBackgroundText__blob"
  />
  <h4>{headingText}</h4>
  <p>{text}</p>
</div>
<style>
  .blobBackgroundText {
    position: relative;
  }
  .blobBackgroundText h4 {
    font-size: 2.25rem;
    font-family: 'Recoleta', serif;
    font-weight: 400;
  }
  .blobBackgroundText__blob {
    position: absolute;
    z-index: -1;
    left: -2rem;
  }
  @media (max-width: 550px) {
    .blobBackgroundText {
      text-align: center;
      max-width: 50vw;
    }
  }
</style>
